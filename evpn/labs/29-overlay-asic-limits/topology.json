 "checks": {
  "vni-everywhere": [
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 10.20.0.40",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "host1",
    "cmd": "ip -o link show type macvlan | wc -l | grep -q 50 || mac-flood 50 eth1 10.10 >/dev/null; ip -o link show type macvlan | wc -l",
    "expect": "^50",
    "desc": ""
   },
   {
    "node": "leaf2",
    "cmd": "vtysh -c 'show evpn vni 10010'",
    "expect": "Number of MACs \\(local and remote\\) known for this VNI: (5[0-9]|[6-9][0-9])",
    "desc": ""
   },
   {
    "node": "leaf3",
    "cmd": "bridge fdb show dev vxlan10010 | grep -c '^02:'",
    "expect": "^(4[0-9]|5[0-9])",
    "desc": ""
   }
  ],
  "vni-where-needed": [
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 10.20.0.40",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "host1",
    "cmd": "ip -o link show type macvlan | wc -l | grep -q 50 || mac-flood 50 eth1 10.10 >/dev/null; ip -o link show type macvlan | wc -l",
    "expect": "^50",
    "desc": ""
   },
   {
    "node": "leaf2",
    "cmd": "vtysh -c 'show evpn vni 10010'",
    "expect": "Number of MACs \\(local and remote\\) known for this VNI: (5[0-9]|[6-9][0-9])",
    "desc": ""
   },
   {
    "node": "leaf3",
    "cmd": "ip link show vxlan10010",
    "expect": "does not exist",
    "desc": ""
   },
   {
    "node": "leaf3",
    "cmd": "ip route show vrf A | grep -cE '^10\\.10\\.1[0-9]{2}\\.'",
    "expect": "^(4[0-9]|5[0-9])",
    "desc": ""
   }
  ]
 }
