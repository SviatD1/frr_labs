  ]
 ],
 "checks": {
  "static": [
   {
    "node": "host1",
    "cmd": "ping -6 -c 3 -W 1 fd00:10::20",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "host1",
    "cmd": "ping -6 -c 3 -W 1 fd00:20::30",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 10.20.20.30",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "vtysh -c 'show evpn arp-cache vni 10010'",
    "expect": "fd00:10::20\\s+remote",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "ip -6 route show vrf A fd00:20::30",
    "expect": "via ::ffff:3\\.3\\.3\\.3|via 3\\.3\\.3\\.3|vlan4001",
    "desc": ""
   }
  ],
  "slaac": [
   {
    "node": "host1",
    "cmd": "ip -6 addr show dev eth1",
    "expect": "fd00:10::2aa:aaff:feaa:aaaa",
    "desc": ""
   },
   {
    "node": "host1",
    "cmd": "ping -6 -c 3 -W 1 fd00:20::2cc:ccff:fecc:cccc",
    "expect": " 0% packet loss",
    "desc": ""
   }
  ]
 }
}