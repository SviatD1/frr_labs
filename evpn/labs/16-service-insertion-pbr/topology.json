{
 "lab": "16-service-insertion-pbr",
 "title": "Service Insertion in EVPN using PBR",
 "project": "evpn-16-service-insertion-pbr",
 "video": "https://www.youtube.com/watch?v=VsSOVx5P3UM",
 "variants": {
  "one-way": "PBR on leaf1 only (asymmetric through the fw)",
  "symmetric": "PBR on leaf1 and on leaf2 for the return direction"
 },
 "default_variant": "symmetric",
 "nodes": [
  {
   "name": "spine1",
   "kind": "router",
   "role": "spine",
   "adapters": 13,
   "ram": 512,
   "x": -80,
   "y": -130
  },
  {
   "name": "spine2",
   "kind": "router",
   "role": "spine",
   "adapters": 13,
   "ram": 512,
   "x": 80,
   "y": -130
  },
  {
   "name": "leaf1",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": -160,
   "y": 40
  },
  {
   "name": "leaf2",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": 0,
   "y": 40
  },
  {
   "name": "leaf3",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": 160,
   "y": 40
  },
  {
   "name": "fw",
   "kind": "router",
   "role": "fw",
   "adapters": 13,
   "ram": 512,
   "x": -160,
   "y": 210
  },
  {
   "name": "host1",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": 0,
   "y": 210
  },
  {
   "name": "host2",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": 160,
   "y": 210
  }
 ],
 "links": [
  [
   "spine1",
   "eth1",
   "leaf1",
   "eth11"
  ],
  [
   "spine1",
   "eth2",
   "leaf2",
   "eth11"
  ],
  [
   "spine1",
   "eth3",
   "leaf3",
   "eth11"
  ],
  [
   "spine2",
   "eth1",
   "leaf1",
   "eth12"
  ],
  [
   "spine2",
   "eth2",
   "leaf2",
   "eth12"
  ],
  [
   "spine2",
   "eth3",
   "leaf3",
   "eth12"
  ],
  [
   "leaf1",
   "eth1",
   "host1",
   "eth1"
  ],
  [
   "leaf2",
   "eth1",
   "host2",
   "eth1"
  ],
  [
   "leaf3",
   "eth1",
   "fw",
   "eth1"
  ],
  [
   "leaf3",
   "eth2",
   "fw",
   "eth2"
  ]
 ],
 "checks": {
  "one-way": [
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 10.20.20.20",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "ip rule show",
    "expect": "from 10\\.10\\.10\\.0/24 to 10\\.20\\.20\\.0/24 iif vlan10",
    "desc": ""
   },
   {
    "node": "host1",
    "cmd": "traceroute -n -w 1 -q 1 10.20.20.20",
    "expect": "172\\.16\\.32\\.1 ",
    "desc": "hop via the fw"
   }
  ],
  "symmetric": [
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 10.20.20.20",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "ip rule show",
    "expect": "from 10\\.10\\.10\\.0/24 to 10\\.20\\.20\\.0/24 iif vlan10",
    "desc": ""
   },
   {
    "node": "host1",
    "cmd": "traceroute -n -w 1 -q 1 10.20.20.20",
    "expect": "172\\.16\\.32\\.1 ",
    "desc": "hop via the fw"
   },
   {
    "node": "host2",
    "cmd": "traceroute -n -w 1 -q 1 10.10.10.10",
    "expect": "172\\.16\\.32\\.1 ",
    "desc": "return via the fw"
   }
  ]
 }
}