{
 "lab": "03-bum-traffic",
 "title": "Handling BUM traffic in EVPN",
 "project": "evpn-03-bum-traffic",
 "video": "https://www.youtube.com/watch?v=r9W8o7jCNzE",
 "variants": {
  "her": "head-end replication, no ARP suppression",
  "arp-suppression": "head-end replication + ARP/ND suppression (+ SVI so the leaves learn host IPs)"
 },
 "default_variant": "her",
 "nodes": [
  {
   "name": "spine1",
   "kind": "router",
   "role": "spine",
   "adapters": 13,
   "ram": 512,
   "x": 0,
   "y": -130
  },
  {
   "name": "leaf1",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": -240,
   "y": 40
  },
  {
   "name": "leaf2",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": -80,
   "y": 40
  },
  {
   "name": "leaf3",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": 80,
   "y": 40
  },
  {
   "name": "leaf4",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": 240,
   "y": 40
  },
  {
   "name": "host1",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": -240,
   "y": 210
  },
  {
   "name": "host2",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": -80,
   "y": 210
  },
  {
   "name": "host3",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": 80,
   "y": 210
  },
  {
   "name": "host4",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": 240,
   "y": 210
  }
 ],
 "links": [
  [
   "spine1",
   "eth1",
   "leaf1",
   "eth11"
  ],
  [
   "spine1",
   "eth2",
   "leaf2",
   "eth11"
  ],
  [
   "spine1",
   "eth3",
   "leaf3",
   "eth11"
  ],
  [
   "spine1",
   "eth4",
   "leaf4",
   "eth11"
  ],
  [
   "leaf1",
   "eth1",
   "host1",
   "eth1"
  ],
  [
   "leaf2",
   "eth1",
   "host2",
   "eth1"
  ],
  [
   "leaf3",
   "eth1",
   "host3",
   "eth1"
  ],
  [
   "leaf4",
   "eth1",
   "host4",
   "eth1"
  ]
 ],
 "checks": {
  "her": [
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 10.10.10.40",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "bridge fdb show dev vxlan10010 | grep 00:00:00:00:00:00",
    "expect": "dst 2\\.2\\.2\\.2[\\s\\S]*dst 3\\.3\\.3\\.3[\\s\\S]*dst 4\\.4\\.4\\.4|dst 4\\.4\\.4\\.4[\\s\\S]*dst 3\\.3\\.3\\.3",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "vtysh -c 'show evpn vni 10010'",
    "expect": "Number of Remote VTEPs: 3|Remote VTEPs for this VNI:",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "bridge -d link show dev vxlan10010",
    "expect": "neigh_suppress off",
    "desc": ""
   }
  ],
  "arp-suppression": [
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 10.10.10.40",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "bridge fdb show dev vxlan10010 | grep 00:00:00:00:00:00",
    "expect": "dst 2\\.2\\.2\\.2[\\s\\S]*dst 3\\.3\\.3\\.3[\\s\\S]*dst 4\\.4\\.4\\.4|dst 4\\.4\\.4\\.4[\\s\\S]*dst 3\\.3\\.3\\.3",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "vtysh -c 'show evpn vni 10010'",
    "expect": "Number of Remote VTEPs: 3|Remote VTEPs for this VNI:",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "bridge -d link show dev vxlan10010",
    "expect": "neigh_suppress on",
    "desc": ""
   },
   {
    "node": "host4",
    "cmd": "ping -c 2 -W 1 10.10.10.1",
    "expect": " 0% packet loss",
    "desc": "host4 ARPs its leaf -> leaf4 learns its IP"
   },
   {
    "node": "leaf1",
    "cmd": "vtysh -c 'show evpn arp-cache vni 10010'",
    "expect": "10\\.10\\.10\\.40\\s+remote",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "ip neigh show dev vlan10",
    "expect": "10\\.10\\.10\\.40 lladdr 00:dd:dd:dd:dd:dd.*extern_learn",
    "desc": ""
   }
  ]
 }
}