 "checks": {
  "default": [
   {
    "node": "sw3",
    "cmd": "bridge link show dev eth2",
    "expect": "state blocking",
    "desc": "sw3<->sw2 is blocked by STP"
   },
   {
    "node": "sw1",
    "cmd": "bridge link show dev eth1",
    "expect": "state forwarding",
    "desc": ""
   },
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 192.168.1.2",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "ip route show 10.2.2.0/24",
    "expect": "nexthop via 10\\.1\\.11\\.11[\\s\\S]*nexthop via 10\\.1\\.12\\.12",
    "desc": "two equal-cost paths"
   },
   {
    "node": "host3",
