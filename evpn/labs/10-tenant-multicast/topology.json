{
 "lab": "10-tenant-multicast",
 "title": "Tenant Multicast in EVPN. OISM with Source Specific Multicast (SSM)",
 "project": "evpn-10-tenant-multicast",
 "video": "https://www.youtube.com/watch?v=vi3Q1ibzB7w",
 "variants": {
  "default": "OISM-like egress routing with pimd SSM in VRF A"
 },
 "default_variant": "default",
 "nodes": [
  {
   "name": "spine1",
   "kind": "router",
   "role": "spine",
   "adapters": 13,
   "ram": 512,
   "x": 0,
   "y": -130
  },
  {
   "name": "leaf1",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": -160,
   "y": 40
  },
  {
   "name": "leaf2",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": 0,
   "y": 40
  },
  {
   "name": "leaf3",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": 160,
   "y": 40
  },
  {
   "name": "host1",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": -240,
   "y": 210
  },
  {
   "name": "host2",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": -80,
   "y": 210
  },
  {
   "name": "host3",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": 80,
   "y": 210
  },
  {
   "name": "host4",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": 240,
   "y": 210
  }
 ],
 "links": [
  [
   "spine1",
   "eth1",
   "leaf1",
   "eth11"
  ],
  [
   "spine1",
   "eth2",
   "leaf2",
   "eth11"
  ],
  [
   "spine1",
   "eth3",
   "leaf3",
   "eth11"
  ],
  [
   "leaf1",
   "eth1",
   "host1",
   "eth1"
  ],
  [
   "leaf2",
   "eth1",
   "host2",
   "eth1"
  ],
  [
   "leaf3",
   "eth1",
   "host3",
   "eth1"
  ],
  [
   "leaf3",
   "eth2",
   "host4",
   "eth1"
  ]
 ],
 "checks": {
  "default": [
   {
    "node": "host1",
    "cmd": "ping -c 2 -W 1 10.20.20.40",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "host1",
    "cmd": "kill -0 $(cat /tmp/ms.pid 2>/dev/null) 2>/dev/null || { setsid mcast-send 232.1.1.1 -n 0.5 >/dev/null 2>&1 & echo $! > /tmp/ms.pid; }; echo started",
    "expect": "started",
    "desc": ""
   },
   {
    "node": "host2",
    "cmd": "timeout 20 mcast-recv 232.1.1.1 10.10.10.10 -c 3",
    "expect": "received 3",
    "desc": "routed on leaf2 (VLAN10 -> VLAN20)"
   },
   {
    "node": "host4",
    "cmd": "timeout 20 mcast-recv 232.1.1.1 10.10.10.10 -c 3",
    "expect": "received 3",
    "desc": "routed on leaf3"
   },
   {
    "node": "host3",
    "cmd": "timeout 20 mcast-recv 232.1.1.1 10.10.10.10 -c 3",
    "expect": "received 3",
    "desc": "bridged in VLAN10"
   },
   {
    "node": "leaf2",
    "cmd": "vtysh -c 'show ip mroute vrf A'",
    "expect": "10\\.10\\.10\\.10\\s+232\\.1\\.1\\.1",
    "desc": ""
   }
  ]
 }
}