{
 "lab": "18-clos-topology",
 "title": "Clos / Leaf-Spine-Leaf Topology for EVPN Data Center",
 "project": "evpn-18-clos-topology",
 "video": "https://www.youtube.com/watch?v=WHt-zH8idDo",
 "variants": {
  "non-blocking": "2 x 100M down, 2 x 100M up per leaf (1:1)",
  "oversubscribed": "2 x 100M down, 2 x 50M up per leaf (2:1)"
 },
 "default_variant": "non-blocking",
 "nodes": [
  {
   "name": "spine1",
   "kind": "router",
   "role": "spine",
   "adapters": 13,
   "ram": 512,
   "x": -80,
   "y": -130
  },
  {
   "name": "spine2",
   "kind": "router",
   "role": "spine",
   "adapters": 13,
   "ram": 512,
   "x": 80,
   "y": -130
  },
  {
   "name": "leaf1",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": -80,
   "y": 40
  },
  {
   "name": "leaf2",
   "kind": "router",
   "role": "leaf",
   "adapters": 13,
   "ram": 512,
   "x": 80,
   "y": 40
  },
  {
   "name": "host1",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": -240,
   "y": 210
  },
  {
   "name": "host2",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": -80,
   "y": 210
  },
  {
   "name": "host3",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": 80,
   "y": 210
  },
  {
   "name": "host4",
   "kind": "host",
   "role": "host",
   "adapters": 3,
   "ram": 256,
   "x": 240,
   "y": 210
  }
 ],
 "links": [
  [
   "spine1",
   "eth1",
   "leaf1",
   "eth11"
  ],
  [
   "spine1",
   "eth2",
   "leaf2",
   "eth11"
  ],
  [
   "spine2",
   "eth1",
   "leaf1",
   "eth12"
  ],
  [
   "spine2",
   "eth2",
   "leaf2",
   "eth12"
  ],
  [
   "leaf1",
   "eth1",
   "host1",
   "eth1"
  ],
  [
   "leaf1",
   "eth2",
   "host2",
   "eth1"
  ],
  [
   "leaf2",
   "eth1",
   "host3",
   "eth1"
  ],
  [
   "leaf2",
   "eth2",
   "host4",
   "eth1"
  ]
 ],
 "checks": {
  "non-blocking": [
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 10.20.20.30",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "ip route show 10.20.20.0/24",
    "expect": "nexthop via 10\\.1\\.11\\.11[\\s\\S]*nexthop via 10\\.1\\.12\\.12",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "tc qdisc show dev eth11",
    "expect": "tbf .*rate 100Mbit",
    "desc": ""
   }
  ],
  "oversubscribed": [
   {
    "node": "host1",
    "cmd": "ping -c 3 -W 1 10.20.20.30",
    "expect": " 0% packet loss",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "ip route show 10.20.20.0/24",
    "expect": "nexthop via 10\\.1\\.11\\.11[\\s\\S]*nexthop via 10\\.1\\.12\\.12",
    "desc": ""
   },
   {
    "node": "leaf1",
    "cmd": "tc qdisc show dev eth11",
    "expect": "tbf .*rate 50Mbit",
    "desc": ""
   }
  ]
 }
}